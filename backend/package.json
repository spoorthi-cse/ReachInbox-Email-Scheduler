{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n API,WORKER -c blue,green \"tsx watch src/server.ts\" \"tsx watch src/worker.ts\"",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@bull-board/api": "^6.7.4",
    "@bull-board/express": "^6.7.4",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.40.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.10.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
